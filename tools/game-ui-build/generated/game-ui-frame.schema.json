{
  "$defs": {
    "GameUiAnalysisChart": {
      "description": "Plot generated from the retained record.",
      "oneOf": [
        {
          "const": "map",
          "description": "Equal-scale horizontal trajectory.",
          "type": "string"
        },
        {
          "const": "altitude",
          "description": "Altitude over recorded time.",
          "type": "string"
        },
        {
          "const": "speed",
          "description": "Air-relative and ground-relative speed.",
          "type": "string"
        }
      ]
    },
    "GameUiButtonLabel": {
      "additionalProperties": false,
      "description": "Label of the retained replay play/pause action.",
      "properties": {
        "id": {
          "description": "Retained control identity.",
          "type": "string"
        },
        "label": {
          "description": "Shared clock-derived label.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "GameUiChartCursor": {
      "additionalProperties": false,
      "description": "Lightweight cursor and selected-sample wind for the retained plot bounds.",
      "properties": {
        "cursor_points": {
          "description": "Shared plot-space sample points.",
          "items": {
            "$ref": "#/$defs/GameUiChartCursorPoint"
          },
          "type": "array"
        },
        "cursor_x": {
          "description": "Time-axis cursor, absent for a horizontal map.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "description": "Retained chart control identity.",
          "type": "string"
        },
        "selected_wind_vector": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameUiChartVector"
            },
            {
              "type": "null"
            }
          ],
          "description": "Selected-sample wind, replacing the first map vector only."
        }
      },
      "required": [
        "id",
        "cursor_x",
        "cursor_points",
        "selected_wind_vector"
      ],
      "type": "object"
    },
    "GameUiChartCursorPoint": {
      "additionalProperties": false,
      "description": "Record-interpolated position with its shared series colour.",
      "properties": {
        "color": {
          "description": "Colour of the corresponding shared series.",
          "type": "string"
        },
        "point": {
          "$ref": "#/$defs/GameUiChartPoint",
          "description": "Position in the chart axes."
        }
      },
      "required": [
        "point",
        "color"
      ],
      "type": "object"
    },
    "GameUiChartPoint": {
      "additionalProperties": false,
      "description": "One chart-space point with units defined by the axes.",
      "properties": {
        "x": {
          "description": "Horizontal component.",
          "format": "double",
          "type": "number"
        },
        "y": {
          "description": "Vertical component.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "GameUiChartVector": {
      "additionalProperties": false,
      "description": "Clipped vector with simultaneously present or absent endpoints.",
      "properties": {
        "color": {
          "description": "Shared colour.",
          "type": "string"
        },
        "label": {
          "description": "Legend label.",
          "type": "string"
        },
        "segment": {
          "description": "Visible segment, absent for zero wind or outside the chart.",
          "items": {
            "$ref": "#/$defs/GameUiChartPoint"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "color",
        "segment"
      ],
      "type": "object"
    },
    "GameUiHud": {
      "additionalProperties": false,
      "description": "Shared Web-baseline HUD model; no adapter rederives flight values or labels.",
      "properties": {
        "angle_of_attack": {
          "description": "AoA text, including explicit missing-angle marker.",
          "type": [
            "string",
            "null"
          ]
        },
        "angle_of_attack_degrees": {
          "description": "Defined angle of attack in degrees.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "angle_of_attack_label": {
          "description": "AoA instrument label.",
          "type": "string"
        },
        "attitude": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameUiHudAttitude"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADI input already converted into display degrees."
        },
        "controls_description": {
          "description": "Canonical input instructions.",
          "type": "string"
        },
        "flight_path_angle_degrees": {
          "description": "Flight path indicator angle.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/GameUiHudGeometry",
          "description": "Shared Web-baseline instrument projections, independent of engine pixels."
        },
        "heading": {
          "description": "Heading instrument text.",
          "type": [
            "string",
            "null"
          ]
        },
        "heading_degrees": {
          "description": "True heading in [0,360).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "heading_label": {
          "description": "Heading instrument label.",
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/GameUiHudLayout",
          "description": "Shared Web-baseline instrument placement and responsive dimensions."
        },
        "location": {
          "description": "Local-frame geographic display.",
          "type": "string"
        },
        "map_attribution": {
          "description": "Preserved map attribution.",
          "type": "string"
        },
        "pilot_position": {
          "description": "Pilot displacement instrument text.",
          "type": [
            "string",
            "null"
          ]
        },
        "pilot_position_label": {
          "description": "Pilot instrument label.",
          "type": "string"
        },
        "readouts": {
          "description": "Primary readouts with shared wording and precision.",
          "type": "string"
        },
        "status": {
          "description": "Domain-derived state label.",
          "type": "string"
        },
        "supplementary_readouts": {
          "description": "Angular rates, physical incidences and pilot target text.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "telemetry": {
          "description": "Distance, time and ground-speed text.",
          "type": "string"
        },
        "warning": {
          "description": "Terminal or model warning.",
          "type": [
            "string",
            "null"
          ]
        },
        "wind": {
          "description": "NED wind readout.",
          "type": [
            "string",
            "null"
          ]
        },
        "wind_direction_degrees": {
          "description": "Ambient air movement direction in [0,360).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "wind_label": {
          "description": "Wind instrument label.",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "geometry",
        "status",
        "attitude",
        "flight_path_angle_degrees",
        "warning",
        "heading_degrees",
        "wind_direction_degrees",
        "angle_of_attack_degrees",
        "readouts",
        "heading",
        "heading_label",
        "pilot_position",
        "pilot_position_label",
        "wind",
        "wind_label",
        "angle_of_attack",
        "angle_of_attack_label",
        "telemetry",
        "location",
        "map_attribution",
        "supplementary_readouts",
        "controls_description"
      ],
      "type": "object"
    },
    "GameUiHudAdiGeometry": {
      "description": "Visible ADI region with an attitude layer or an independent flight path cue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Attitude horizon with an optional flight path marker.",
          "properties": {
            "flight_path_y_ratio": {
              "description": "Flight path marker position relative to the ADI height.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "horizon": {
              "$ref": "#/$defs/GameUiHudAttitudeGeometry",
              "description": "Horizon rotation and translation."
            },
            "kind": {
              "const": "attitude",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "horizon",
            "flight_path_y_ratio"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Flight path marker without an attitude horizon.",
          "properties": {
            "kind": {
              "const": "flight_path_only",
              "type": "string"
            },
            "y_ratio": {
              "description": "Flight path marker position relative to the ADI height.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "y_ratio"
          ],
          "type": "object"
        }
      ]
    },
    "GameUiHudAttitude": {
      "additionalProperties": false,
      "description": "Shared ADI orientation input.",
      "properties": {
        "pitch_degrees": {
          "description": "Pitch angle in degrees.",
          "format": "double",
          "type": "number"
        },
        "roll_degrees": {
          "description": "Bank angle in degrees.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "roll_degrees",
        "pitch_degrees"
      ],
      "type": "object"
    },
    "GameUiHudAttitudeGeometry": {
      "additionalProperties": false,
      "description": "Web-baseline horizon rotation and translation.",
      "properties": {
        "pitch_offset_ratio": {
          "description": "Pre-rotation pitch translation relative to the ADI height.",
          "format": "double",
          "type": "number"
        },
        "rotation_degrees": {
          "description": "Clockwise horizon rotation in display coordinates.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "rotation_degrees",
        "pitch_offset_ratio"
      ],
      "type": "object"
    },
    "GameUiHudGeometry": {
      "additionalProperties": false,
      "description": "Shared instrument geometry derived from the authoritative HUD angles.",
      "properties": {
        "adi": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameUiHudAdiGeometry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Visible ADI layers, absent when both attitude and flight path cues are hidden."
        },
        "angle_of_attack_ratio": {
          "description": "AoA position between the displayed -10 and +20 degree endpoints.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "heading_ticks": {
          "description": "Ordered heading tape marks and compass labels.",
          "items": {
            "$ref": "#/$defs/GameUiHudHeadingTick"
          },
          "type": "array"
        }
      },
      "required": [
        "adi",
        "heading_ticks",
        "angle_of_attack_ratio"
      ],
      "type": "object"
    },
    "GameUiHudHeadingTick": {
      "additionalProperties": false,
      "description": "One heading tape mark in normalized instrument coordinates.",
      "properties": {
        "label": {
          "description": "Compass label, empty for a minor tick.",
          "type": "string"
        },
        "major": {
          "description": "Major marks receive the long tick and a compass label.",
          "type": "boolean"
        },
        "position_ratio": {
          "description": "Position relative to the complete tape width.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "position_ratio",
        "major",
        "label"
      ],
      "type": "object"
    },
    "GameUiHudLayout": {
      "additionalProperties": false,
      "description": "Instrument placement in logical pixels with platform safe-area insets applied by adapters.",
      "properties": {
        "attitude_size_px": {
          "description": "ADI width and height.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "controls_visible": {
          "description": "Keyboard description visibility on the selected viewport.",
          "type": "boolean"
        },
        "font_size_px": {
          "description": "Readout font size.",
          "format": "double",
          "type": "number"
        },
        "gap_px": {
          "description": "Horizontal and vertical grid gaps.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "instrument_columns": {
          "description": "Heading, pilot, wind and AoA instrument column count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_height_px": {
          "description": "Reachable vertical scroll height.",
          "format": "double",
          "type": "number"
        },
        "offset_px": {
          "description": "Left and top viewport offsets.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "opacity": {
          "description": "Panel background opacity.",
          "format": "double",
          "type": "number"
        },
        "padding_px": {
          "description": "Horizontal and vertical padding.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "width_px": {
          "description": "Responsive panel width.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "offset_px",
        "width_px",
        "maximum_height_px",
        "padding_px",
        "gap_px",
        "attitude_size_px",
        "font_size_px",
        "opacity",
        "controls_visible",
        "instrument_columns"
      ],
      "type": "object"
    },
    "GameUiPauseOverlay": {
      "description": "Exclusive pause overlay.",
      "oneOf": [
        {
          "const": "menu",
          "description": "Pause navigation.",
          "type": "string"
        },
        {
          "const": "settings",
          "description": "Render settings.",
          "type": "string"
        },
        {
          "const": "help",
          "description": "Input instructions.",
          "type": "string"
        }
      ]
    },
    "GameUiRangeValue": {
      "additionalProperties": false,
      "description": "Value of a retained typed range control.",
      "properties": {
        "display_value": {
          "description": "Shared one-decimal display text.",
          "type": "string"
        },
        "id": {
          "description": "Retained control identity.",
          "type": "string"
        },
        "value": {
          "description": "Shared finite range value.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "value",
        "display_value"
      ],
      "type": "object"
    },
    "GameUiReadoutValue": {
      "additionalProperties": false,
      "description": "Text of a retained record readout.",
      "properties": {
        "id": {
          "description": "Retained control identity.",
          "type": "string"
        },
        "value": {
          "description": "Shared formatted record or clock observation.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value"
      ],
      "type": "object"
    },
    "GameUiReplayCamera": {
      "description": "Current Web replay camera candidates in their shared selection order.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Recorded-event camera director.",
          "type": "string"
        },
        {
          "const": "pilot",
          "description": "Pilot eye view.",
          "type": "string"
        },
        {
          "const": "chase",
          "description": "Aircraft-following view.",
          "type": "string"
        },
        {
          "const": "orbit",
          "description": "Orbiting aircraft view.",
          "type": "string"
        },
        {
          "const": "platform",
          "description": "Launch-platform fixed view.",
          "type": "string"
        },
        {
          "const": "shore",
          "description": "Lake-shore fixed view.",
          "type": "string"
        },
        {
          "const": "overhead",
          "description": "Overhead aircraft view.",
          "type": "string"
        },
        {
          "const": "side",
          "description": "Side-on aircraft view.",
          "type": "string"
        },
        {
          "const": "front",
          "description": "Forward aircraft view.",
          "type": "string"
        },
        {
          "const": "telephoto",
          "description": "Fixed distant telephoto view.",
          "type": "string"
        }
      ]
    },
    "GameUiReplayView": {
      "description": "Replay presentation selection.",
      "oneOf": [
        {
          "const": "cinematic",
          "description": "Scenic replay.",
          "type": "string"
        },
        {
          "const": "telemetry",
          "description": "Scenic replay with telemetry.",
          "type": "string"
        },
        {
          "const": "analysis",
          "description": "Record plot and shared cursor.",
          "type": "string"
        }
      ]
    },
    "GameUiResultTab": {
      "description": "Result presentation mode.",
      "oneOf": [
        {
          "const": "summary",
          "description": "Condensed result and navigation.",
          "type": "string"
        },
        {
          "const": "analysis",
          "description": "Recorded analysis charts.",
          "type": "string"
        }
      ]
    },
    "GameUiState": {
      "additionalProperties": false,
      "description": "UI-only selections; physical state and domain phase remain in GameSession.",
      "properties": {
        "analysis_chart": {
          "$ref": "#/$defs/GameUiAnalysisChart",
          "description": "Selected record plot."
        },
        "analysis_time_seconds": {
          "description": "Read-only analysis query position in seconds.",
          "format": "double",
          "type": "number"
        },
        "pause_overlay": {
          "$ref": "#/$defs/GameUiPauseOverlay",
          "description": "Paused menu selection."
        },
        "replay_camera": {
          "$ref": "#/$defs/GameUiReplayCamera",
          "description": "Shared replay camera selection; adapters only apply its geometry."
        },
        "replay_view": {
          "$ref": "#/$defs/GameUiReplayView",
          "description": "Replay presentation selection."
        },
        "result_tab": {
          "$ref": "#/$defs/GameUiResultTab",
          "description": "Result presentation selection."
        },
        "technical_open": {
          "description": "Expanded preparation diagnostics.",
          "type": "boolean"
        }
      },
      "required": [
        "technical_open",
        "result_tab",
        "analysis_chart",
        "analysis_time_seconds",
        "pause_overlay",
        "replay_view",
        "replay_camera"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Lightweight per-frame UI observation associated with one published structural view.",
  "properties": {
    "button_labels": {
      "description": "Replay clock play/pause label.",
      "items": {
        "$ref": "#/$defs/GameUiButtonLabel"
      },
      "type": "array"
    },
    "chart_cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/GameUiChartCursor"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cursor-only chart observation; plotted series and bounds remain in the view."
    },
    "hud": {
      "anyOf": [
        {
          "$ref": "#/$defs/GameUiHud"
        },
        {
          "type": "null"
        }
      ],
      "description": "Shared HUD projection, never a second physical state."
    },
    "ranges": {
      "description": "Existing range values that advance without a structural change.",
      "items": {
        "$ref": "#/$defs/GameUiRangeValue"
      },
      "type": "array"
    },
    "readouts": {
      "description": "Fixed record-clock and analysis-cursor readouts.",
      "items": {
        "$ref": "#/$defs/GameUiReadoutValue"
      },
      "type": "array"
    },
    "selections": {
      "$ref": "#/$defs/GameUiState",
      "description": "Readonly observation of the Rust-owned UI selections."
    },
    "view_revision": {
      "description": "Structural view revision retained by the query adapter.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "view_revision",
    "selections",
    "hud",
    "ranges",
    "readouts",
    "button_labels",
    "chart_cursor"
  ],
  "title": "GameUiFrame",
  "type": "object",
  "$id": "https://tokutori.github.io/pr-simulator-game-1/game-ui/frame"
}
