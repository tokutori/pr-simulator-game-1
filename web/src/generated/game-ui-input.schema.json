{
  "$defs": {
    "GameUiPresentationMode": {
      "description": "Presentation mode supported by a platform adapter.",
      "oneOf": [
        {
          "const": "screen",
          "description": "Flat native or browser display.",
          "type": "string"
        },
        {
          "const": "webxr",
          "description": "Browser HMD display.",
          "type": "string"
        },
        {
          "const": "phone_vr",
          "description": "Browser phone headset display.",
          "type": "string"
        }
      ]
    },
    "GameUiReplayCamera": {
      "description": "Current Web replay camera candidates in their shared selection order.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Recorded-event camera director.",
          "type": "string"
        },
        {
          "const": "pilot",
          "description": "Pilot eye view.",
          "type": "string"
        },
        {
          "const": "chase",
          "description": "Aircraft-following view.",
          "type": "string"
        },
        {
          "const": "orbit",
          "description": "Orbiting aircraft view.",
          "type": "string"
        },
        {
          "const": "platform",
          "description": "Launch-platform fixed view.",
          "type": "string"
        },
        {
          "const": "shore",
          "description": "Lake-shore fixed view.",
          "type": "string"
        },
        {
          "const": "overhead",
          "description": "Overhead aircraft view.",
          "type": "string"
        },
        {
          "const": "side",
          "description": "Side-on aircraft view.",
          "type": "string"
        },
        {
          "const": "front",
          "description": "Forward aircraft view.",
          "type": "string"
        },
        {
          "const": "telephoto",
          "description": "Fixed distant telephoto view.",
          "type": "string"
        }
      ]
    },
    "GameUiStoredRecord": {
      "additionalProperties": false,
      "description": "Persistence metadata, not an independent flight record.",
      "properties": {
        "id": {
          "description": "Platform key.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "personal_best": {
          "description": "Existing Rust-derived Personal Best membership.",
          "type": "boolean"
        },
        "saved_at": {
          "description": "Formatted local save timestamp supplied by the platform.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "saved_at",
        "personal_best"
      ],
      "type": "object"
    },
    "GameUiViewport": {
      "additionalProperties": false,
      "description": "Logical pixels and root-font size used by the same responsive calculation.",
      "properties": {
        "height": {
          "description": "Display height in logical pixels.",
          "format": "double",
          "type": "number"
        },
        "root_font_size": {
          "description": "Platform root font size in logical pixels.",
          "format": "double",
          "type": "number"
        },
        "width": {
          "description": "Display width in logical pixels.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "root_font_size"
      ],
      "type": "object"
    },
    "GameUiWaterQuality": {
      "description": "Rendering quality has no effect on physics or record identity.",
      "oneOf": [
        {
          "const": "low",
          "description": "Reduced mesh density.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Balanced mesh density.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "Detailed mesh density.",
          "type": "string"
        }
      ]
    },
    "GameUiWaterQualityOperation": {
      "description": "Exclusive observation of a platform-owned water resource operation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No resource operation is pending and prior resources were released.",
          "properties": {
            "kind": {
              "const": "idle",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A replacement has been requested and the confirmed resource remains active.",
          "properties": {
            "kind": {
              "const": "applying",
              "type": "string"
            },
            "requested": {
              "$ref": "#/$defs/GameUiWaterQuality",
              "description": "Requested replacement quality."
            }
          },
          "required": [
            "kind",
            "requested"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replacement failed before commitment; the confirmed resource remains active.",
          "properties": {
            "cause": {
              "description": "Captured resource preparation cause.",
              "type": "string"
            },
            "kind": {
              "const": "failed",
              "type": "string"
            },
            "requested": {
              "$ref": "#/$defs/GameUiWaterQuality",
              "description": "Failed replacement quality."
            }
          },
          "required": [
            "kind",
            "requested",
            "cause"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replacement committed, but release of the superseded resource failed.",
          "properties": {
            "cause": {
              "description": "Captured superseded-resource cleanup cause.",
              "type": "string"
            },
            "kind": {
              "const": "cleanup_failed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cause"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Browser or OS observations that never own game physics or phase.",
  "properties": {
    "analysis_available": {
      "description": "Platform supports full record plots.",
      "type": "boolean"
    },
    "flight_controller_failure": {
      "description": "Captured flight-controller resource failure; the session retains its last valid state.",
      "type": [
        "string",
        "null"
      ]
    },
    "flight_log_available": {
      "description": "Platform supports record downloads.",
      "type": "boolean"
    },
    "flight_log_pending": {
      "description": "A download request for the current resource owner remains pending.",
      "type": "boolean"
    },
    "head_hud_failure": {
      "description": "Captured head-HUD resource failure, separate from the domain and physical state.",
      "type": [
        "string",
        "null"
      ]
    },
    "notification": {
      "description": "Platform operation feedback.",
      "type": "string"
    },
    "operation_pending": {
      "description": "Blocks operations while the owning adapter is transitioning.",
      "type": "boolean"
    },
    "phone_vr_available": {
      "description": "Phone sensor headset support.",
      "type": "boolean"
    },
    "presentation_mode": {
      "$ref": "#/$defs/GameUiPresentationMode",
      "description": "Actual active presentation mode."
    },
    "replay_available": {
      "description": "Platform supports recorded scenic playback.",
      "type": "boolean"
    },
    "stored_records": {
      "description": "Persistence results associated with this owner.",
      "items": {
        "$ref": "#/$defs/GameUiStoredRecord"
      },
      "type": "array"
    },
    "stored_records_available": {
      "description": "Platform supports persisted record lookup.",
      "type": "boolean"
    },
    "supported_replay_cameras": {
      "description": "Implemented camera rigs; shared ordering remains the Web ordering.",
      "items": {
        "$ref": "#/$defs/GameUiReplayCamera"
      },
      "type": "array"
    },
    "viewport": {
      "$ref": "#/$defs/GameUiViewport",
      "description": "Current physical display viewport."
    },
    "water_quality": {
      "$ref": "#/$defs/GameUiWaterQuality",
      "description": "Confirmed current render quality."
    },
    "water_quality_operation": {
      "$ref": "#/$defs/GameUiWaterQualityOperation",
      "description": "Actual resource preparation, commitment and cleanup observation."
    },
    "webxr_available": {
      "description": "Browser WebXR support.",
      "type": "boolean"
    }
  },
  "required": [
    "viewport",
    "presentation_mode",
    "operation_pending",
    "webxr_available",
    "phone_vr_available",
    "analysis_available",
    "replay_available",
    "supported_replay_cameras",
    "stored_records_available",
    "flight_log_available",
    "flight_log_pending",
    "water_quality",
    "water_quality_operation",
    "notification",
    "stored_records"
  ],
  "title": "GameUiPlatformInput",
  "type": "object",
  "$id": "https://tokutori.github.io/pr-simulator-game-1/game-ui/input"
}
